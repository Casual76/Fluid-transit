<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Posizione: finora arrivava dal manifest di MapLibre; dichiararla
         qui e' onesta' verso chi legge, non un cambio di comportamento. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Il mic evoluto della Fase 5: si registra solo col dito sul tasto. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Le routine (Fase 6): sveglie esatte per "esci tra X minuti" — il
         WorkManager ha un pavimento di 15 minuti — e notifiche. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- La navigazione (Fase 7): foreground service col tipo che segue il
         modo viaggio — location SOLO in Preciso, dataSync negli altri. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".FluidTransitApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FluidTransit">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- I due widget Glance della Fase 6. -->
        <receiver
            android:name=".ui.widget.StopWidgetReceiver"
            android:exported="true"
            android:label="Partenze fermata">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stop_widget_info" />
        </receiver>
        <receiver
            android:name=".ui.widget.RoutineWidgetReceiver"
            android:exported="true"
            android:label="La tua routine">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/routine_widget_info" />
        </receiver>
        <activity
            android:name=".ui.widget.StopWidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Il servizio della navigazione a bordo (Fase 7). -->
        <service
            android:name=".data.nav.NavigationService"
            android:exported="false"
            android:foregroundServiceType="location|dataSync" />

        <!-- Le sveglie delle routine e il loro riarmo dopo un riavvio. -->
        <!--
          La sveglia dei widget: updatePeriodMillis non scende sotto la
          mezz'ora, e mezz'ora su un conteggio di minuti sono numeri
          sbagliati di mezz'ora.
        -->
        <receiver
            android:name=".ui.widget.WidgetRefresher$Receiver"
            android:exported="false" />
        <receiver
            android:name=".data.routines.RoutineReceiver"
            android:exported="false" />
        <receiver
            android:name=".data.routines.RoutineBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
